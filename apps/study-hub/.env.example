# study-hub 本地配置模板。复制为 .env 后填自己的值。
# server/main.js 会自动读取此文件；已存在的环境变量优先，.env 不覆盖。
# .env 已被 projects/.gitignore 忽略，绝不要把真实密钥写进 .env.example。

# ── learning 仓与判题环境 ─────────────────────────
# learning 仓根目录；未设时为纯本地模式（不与 learning 仓同步）
STUDY_HUB_LEARNING_ROOT=C:/code/learning

# 判题用 Python 解释器。本机多解释器时指定带 numpy 的一个。
# 实测本机：python 3.11 无 numpy；py -3 是 Python 3.12，含 numpy 2.5.5。
STUDY_HUB_PYTHON=py -3

# 工程仓内置题库根；未设时使用应用默认值
# STUDY_HUB_LOCAL_BANK=C:/code/projects/apps/study-hub/bank

# 服务端口
PORT=5173

# ── LLM（不配置密钥时所有离线功能仍可用）─────────
# 方舟密钥（不需要时留空）
ARK_API_KEY=
# 方舟服务地址（可选；默认 https://ark.cn-beijing.volces.com/api/v3）
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Anthropic 密钥（二选一即可，不需要时留空）
ANTHROPIC_API_KEY=

# LLM 总开关：0 / false / off / no = 关闭；未设置时按密钥自动判断
# STUDY_HUB_LLM_ENABLED=
# provider：ark / anthropic / null；未设置时按密钥推断
# STUDY_HUB_LLM_PROVIDER=ark
# 模型名；未设置时使用 provider 默认模型
# STUDY_HUB_LLM_MODEL=
# 通用 API 地址覆盖（可选）
# STUDY_HUB_LLM_BASE_URL=

# LLM 配额护栏
STUDY_HUB_LLM_SESSION_LIMIT=20
STUDY_HUB_LLM_DAILY_LIMIT=100
